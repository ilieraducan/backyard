wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\n<p><strong>Deutschlandweit &amp; Europa</strong><br>Einsätze in ganz Deutschland, größere Projekte europaweit</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\n<p><strong>Alle gängigen Dachformen</strong><br>Schrägdach, Flachdach, Trapezblech- und Gewerbedächer</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\n<p><strong>Saubere Dokumentation</strong><br>Fotodokumentation und Übergabe nach jedem Einsatz</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:column -->\n</div>\n<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\": \"il-section\", \"layout\": {\"type\": \"constrained\"}} -->\n<div class=\"wp-block-group il-section\"><!-- wp:heading {\"level\": 2} -->\n<h2 class=\"wp-block-heading\">Unsere Leistungen</h2>\n<!-- /wp:heading -->\n<!-- wp:columns {\"className\": \"il-cards\"}-->\n<div class=\"wp-block-columns il-cards\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"className\": \"il-card\", \"layout\": {\"type\": \"constrained\"}} -->\n<div class=\"wp-block-group il-card\"><!-- wp:image {\"id\": 132, \"sizeSlug\": \"large\", \"linkDestination\": \"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{U:132}}\" alt=\"PV-Montage auf einem Gewerbe-Flachdach\" class=\"wp-image-132\"/></figure>\n<!-- /wp:image -->\n<!-- wp:heading {\"level\": 3} -->\n<h3 class=\"wp-block-heading\">Gewerbe &amp; Industrie</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Montage auf Hallen-, Flach- und Trapezblechdächern – auch bei großen Modulfeldern.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph{\"className\": \"il-more\"} -->\n<p class=\"il-more\"><a href=\"/pv-montage-industrie/\">Mehr erfahren →</a></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"className\": \"il-card\", \"layout\": {\"type\": \"constrained\"}} -->\n<div class=\"wp-block-group il-card\"><!-- wp:image {\"id\": 100, \"sizeSlug\": \"large\", \"linkDestination\": \"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{U:100}}\" alt=\"Montageteam bei der Modulmontage\" class=\"wp-image-100\"/></figure>\n<!-- /wp:image -->\n<!-- wp:heading {\"level\": 3} -->\n<h3 class=\"wp-block-heading\">Subunternehmer für Projektierer</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Ihr Montagepartner für laufende und geplante Projekte – nach Ihren Vorgaben und Plänen.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph{\"className\": \"il-more\"} -->\n<p class=\"il-more\"><a href=\"/pv-montage-subunternehmer/\">Mehr erfahren →</a></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:column -->\n</div>\n<!-- /wp:columns -->\n<!-- wp:columns {\"className\": \"il-cards\"}-->\n<div class=\"wp-block-columns il-cards\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"className\": \"il-card\", \"layout\": {\"type\": \"constrained\"}} -->\n<div class=\"wp-block-group il-card\"><!-- wp:image {\"id\": 117, \"sizeSlug\": \"large\", \"linkDestination\": \"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{U:117}}\" alt=\"PV-Anlage auf einem Ziegeldach eines Wohnhauses\" class=\"wp-image-117\"/></figure>\n<!-- /wp:image -->\n<!-- wp:heading {\"level\": 3} -->\n<h3 class=\"wp-block-heading\">Privatkunden</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Mechanische Montage auf Ihrem Wohnhaus – in Zusammenarbeit mit Ihrem Elektrofachbetrieb.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph{\"className\": \"il-more\"} -->\n<p class=\"il-more\"><a href=\"/pv-montage-privatkunden/\">Mehr erfahren →</a></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"className\": \"il-card\", \"layout\": {\"type\": \"constrained\"}} -->\n<div class=\"wp-block-group il-card\"><!-- wp:image {\"id\": 120, \"sizeSlug\": \"large\", \"linkDestination\": \"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{U:120}}\" alt=\"Photovoltaik-Module neben Dachfenstern\" class=\"wp-image-120\"/></figure>\n<!-- /wp:image -->\n<!-- wp:heading {\"level\": 3} -->\n<h3 class=\"wp-block-heading\">PV-Service</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Demontage und Wiedermontage bei Dachsanierung, Erweiterung und Nachrüstung bestehender Anlagen.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph{\"className\": \"il-more\"} -->\n<p class=\"il-more\"><a href=\"/pv-service/\">Mehr erfahren →</a></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:column -->\n</div>\n<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\": \"il-section\", \"layout\": {\"type\": \"constrained\"}} -->\n<div class=\"wp-block-group il-section\"><!-- wp:heading {\"level\": 2} -->\n<h2 class=\"wp-block-heading\">Ihr Montagepartner für PV-Projekte</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>ILTAN Bau e.K. unterstützt Projektierer, Installationsbetriebe, Generalunternehmer und Gewerbekunden bei der Umsetzung von Photovoltaik-Projekten. Sie liefern Planung und Material – wir sorgen für eine saubere, termingerechte Montage auf dem Dach.</p>\n<!-- /wp:paragraph -->\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Montage von Unterkonstruktion und Modulen nach Herstellervorgaben</li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li>DC-seitige Kabelverlegung nach Planung</li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li>Montagevorbereitung und Abstimmung auf der Baustelle</li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li>Fotodokumentation der ausgeführten Arbeiten</li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li>Feste Ansprechpartner und klare Kommunikation während des gesamten Einsatzes</li>\n<!-- /wp:list-item -->\n</ul>\n<!-- /wp:list -->\n<!-- wp:paragraph{\"className\": \"il-note\"} -->\n<p class=\"il-note\">Der elektrische Anschluss (AC-Seite, Netzanschluss, Inbetriebnahme) erfolgt durch einen qualifizierten Elektrofachbetrieb des Auftraggebers bzw. nach Absprache.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\": \"il-band\", \"layout\": {\"type\": \"constrained\"}} -->\n<div class=\"wp-block-group il-band\"><!-- wp:heading {\"level\": 2} -->\n<h2 class=\"wp-block-heading\">Einsatzgebiet</h2>\n<!-- /wp:heading -->\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\n<p><strong>Deutschland</strong><br>Wir arbeiten bundesweit. Unser Sitz ist in Stade bei Hamburg.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\n<p><strong>Europa</strong><br>Für größere Gewerbe- und Industrieprojekte sind wir auch im europäischen Ausland im Einsatz. Sprechen Sie uns mit Projektort, Umfang und Zeitraum an.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:column -->\n</div>\n<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\": \"il-section\", \"layout\": {\"type\": \"constrained\"}} -->\n<div class=\"wp-block-group il-section\"><!-- wp:heading {\"level\": 2} -->\n<h2 class=\"wp-block-heading\">So läuft die Zusammenarbeit</h2>\n<!-- /wp:heading -->\n<!-- wp:columns {\"className\": \"il-steps\"}-->\n<div class=\"wp-block-columns il-steps\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\n<p><strong>1. Anfrage</strong><br>Projektort, Dachart, Größe und Zeitraum per Formular oder WhatsApp senden.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\n<p><strong>2. Angebot</strong><br>Wir prüfen Ihre Unterlagen und melden uns mit einem Angebot.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\n<p><strong>3. Montage</strong><br>Termingerechte Ausführung nach Plan – mit Abstimmung vor Ort.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\n<p><strong>4. Übergabe</strong><br>Fotodokumentation und Übergabe für den elektrischen Anschluss.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:column -->\n</div>\n<!-- /wp:columns -->\n<!-- wp:paragraph{\"className\": \"il-more\"} -->\n<p class=\"il-more\"><a href=\"/projektablauf/\">Projektablauf im Detail →</a></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\": \"il-section\", \"layout\": {\"type\": \"constrained\"}} -->\n<div class=\"wp-block-group il-section\"><!-- wp:heading {\"level\": 2} -->\n<h2 class=\"wp-block-heading\">Einblicke in unsere Projekte</h2>\n<!-- /wp:heading -->\n<!-- wp:gallery {\"columns\": 3, \"linkTo\": \"none\", \"className\": \"il-gallery\"} -->\n<figure class=\"wp-block-gallery has-nested-images columns-3 is-cropped il-gallery\"><!-- wp:image {\"id\": 133, \"sizeSlug\": \"large\", \"linkDestination\": \"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{U:133}}\" alt=\"Photovoltaik-Montage von ILTAN Bau\" class=\"wp-image-133\"/></figure>\n<!-- /wp:image -->\n<!-- wp:image {\"id\": 131, \"sizeSlug\": \"large\", \"linkDestination\": \"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{U:131}}\" alt=\"Photovoltaik-Montage von ILTAN Bau\" class=\"wp-image-131\"/></figure>\n<!-- /wp:image -->\n<!-- wp:image {\"id\": 113, \"sizeSlug\": \"large\", \"linkDestination\": \"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{U:113}}\" alt=\"Photovoltaik-Montage von ILTAN Bau\" class=\"wp-image-113\"/></figure>\n<!-- /wp:image -->\n<!-- wp:image {\"id\": 105, \"sizeSlug\": \"large\", \"linkDestination\": \"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{U:105}}\" alt=\"Photovoltaik-Montage von ILTAN Bau\" class=\"wp-image-105\"/></figure>\n<!-- /wp:image -->\n<!-- wp:image {\"id\": 130, \"sizeSlug\": \"large\", \"linkDestination\": \"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{U:130}}\" alt=\"Photovoltaik-Montage von ILTAN Bau\" class=\"wp-image-130\"/></figure>\n<!-- /wp:image -->\n<!-- wp:image {\"id\": 88, \"sizeSlug\": \"large\", \"linkDestination\": \"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{U:88}}\" alt=\"Photovoltaik-Montage von ILTAN Bau\" class=\"wp-image-88\"/></figure>\n<!-- /wp:image -->\n</figure>\n<!-- /wp:gallery -->\n<!-- wp:paragraph{\"className\": \"il-more\"} -->\n<p class=\"il-more\"><a href=\"/unsere-projekte/\">Alle Projektfotos ansehen →</a></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\": \"il-section\", \"layout\": {\"type\": \"constrained\"}} -->\n<div class=\"wp-block-group il-section\"><!-- wp:heading {\"level\": 2} -->\n<h2 class=\"wp-block-heading\">Häufige Fragen</h2>\n<!-- /wp:heading -->\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Arbeiten Sie auch außerhalb Deutschlands?</summary><!-- wp:paragraph -->\n<p>Ja. In Deutschland arbeiten wir bundesweit, für größere Gewerbe- und Industrieprojekte auch im europäischen Ausland.</p>\n<!-- /wp:paragraph -->\n</details>\n<!-- /wp:details -->\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Übernehmen Sie auch den elektrischen Anschluss?</summary><!-- wp:paragraph -->\n<p>Unser Schwerpunkt ist die mechanische Montage inklusive DC-seitiger Kabelverlegung. Der elektrische Anschluss (AC-Seite, Netzanschluss, Inbetriebnahme) erfolgt durch einen qualifizierten Elektrofachbetrieb des Auftraggebers bzw. nach Absprache.</p>\n<!-- /wp:paragraph -->\n</details>\n<!-- /wp:details -->\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Arbeiten Sie auch für Privatkunden?</summary><!-- wp:paragraph -->\n<p>Ja. Den Schwerpunkt bilden Projekte für Unternehmen, wir montieren aber auch auf Wohnhäusern – in Abstimmung mit Ihrem Elektrofachbetrieb.</p>\n<!-- /wp:paragraph -->\n</details>\n<!-- /wp:details -->\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Welche Unterlagen brauchen Sie für ein Angebot?</summary><!-- wp:paragraph -->\n<p>Projektort, Dachart und -fläche, Anzahl und Typ der Module, Unterkonstruktion und gewünschter Zeitraum. Fotos oder Pläne beschleunigen die Prüfung.</p>\n<!-- /wp:paragraph -->\n</details>\n<!-- /wp:details -->\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Wie schnell erhalte ich eine Rückmeldung?</summary><!-- wp:paragraph -->\n<p>Wir melden uns in der Regel kurzfristig nach Eingang Ihrer Anfrage.</p>\n<!-- /wp:paragraph -->\n</details>\n<!-- /wp:details -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\": \"il-cta\", \"layout\": {\"type\": \"constrained\"}} -->\n<div class=\"wp-block-group il-cta\"><!-- wp:heading {\"level\": 2} -->\n<h2 class=\"wp-block-heading\">Projekt geplant?</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Senden Sie uns die wichtigsten Eckdaten – wir melden uns mit einem Angebot.</p>\n<!-- /wp:paragraph -->\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\": \"il-btn-main\"} -->\n<div class=\"wp-block-button il-btn-main\"><a class=\"wp-block-button__link wp-element-button\" href=\"/kontakt/\">Projekt anfragen</a></div>\n<!-- /wp:button -->\n<!-- wp:button {\"className\": \"il-btn-wa\"} -->\n<div class=\"wp-block-button il-btn-wa\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/4917687800657?text=Hallo%20ILTAN%20Bau%2C%20ich%20habe%20eine%20Projektanfrage%3A%20\">WhatsApp schreiben</a></div>\n<!-- /wp:button -->\n</div>\n<!-- /wp:buttons -->\n</div>\n<!-- /wp:group -->\n", "sub": "<!-- wp:grou